repository-code: "https://github.com/alexisromtz-lab/la-auditora"
url: "https://alexisromtz-lab.github.io/la-auditora/"
date-released: "2026-11-09"
keywords:
  - reproducibility
  - software audit
  - static analysis
  - reachability
  - continuous integration
